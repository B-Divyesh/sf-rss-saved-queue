{
  "manifest_version": 3,
  "name": "RSS Saved Queue",
  "version": "1.0.0",
  "description": "Save the current page to your private RSS Saved Queue.",
  "action": { "default_title": "Save to RSS Saved Queue", "default_popup": "popup.html" },
  "options_page": "options.html",
  "permissions": ["activeTab", "storage", "tabs", "permissions"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
